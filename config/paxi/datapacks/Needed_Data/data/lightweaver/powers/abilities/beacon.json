                                            "type": "origins:and",
                                            "actions": [
                                                {
                                                    "type": "origins:trigger_cooldown",
                                                    "power": "*:*_duration"
                                                },
                                                {
                                                    "type": "origins:change_resource",
                                                    "resource": "*:*_moving",
                                                    "operation": "set",
                                                    "change": 0
                                                }
                                            ]
                                        }
                                    }
                                },
                                {
                                    "type": "origins:target_action",
                                    "action": {
                                        "type": "origins:execute_command",
                                        "command": "function lightweaver:orb/move"
                                    }
                                }
                            ]
                        },
                        "bientity_condition": {
                            "type": "origins:target_condition",
                            "condition": {
                                "type": "origins:and",
                                "conditions": [
                                    {
                                        "type": "origins:command",
                                        "command": "execute if entity @s[tag=weaverLightOrb,type=armor_stand]",
                                        "comparison": "==",
                                        "compare_to": 1
                                    },
                                    {
                                        "type": "origins:command",
                                        "command": "execute as @s if score @a[tag=tempBeaconSelector,sort=nearest,limit=1] BeaconSID = @s BeaconSID",
                                        "comparison": "==",
                                        "compare_to": 1
                                    }
                                ]
                            }
                        },
                        "include_target": false,
                        "radius": 25
                    },
                    {
                        "type": "origins:execute_command",
                        "command": "tag @s remove tempBeaconSelector"
                    },
                    {
                        "type": "origins:change_resource",
                        "resource": "*:*_distance",
                        "operation": "add",
                        "change": 1
                    }
                ]
            }
        },
