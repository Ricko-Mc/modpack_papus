{
    "name": "§6§nBeacon of Light",
    "description": "With your angelic power you can project a shimmering ball of light. It's energy is pure enough to heal wounds and light the way!\n",
    "loading_priority": 10,
    "hidden": false,

    "badges": [
        {
            "type": "origins:keybind",
            "sprite": "origins:textures/gui/badge/active.png",
            "text": "Active ability, use with %s\nCooldown: 20s, cannot be used when another orb is active"
        }
    ],

    "type": "origins:multiple",
    "activate": {
        "type": "apoli:active_self",
        "entity_action": {
            "type": "origins:and",
            "actions": [
                {
                    "type": "origins:play_sound",
                    "sound": "minecraft:entity.illusioner.cast_spell",
                    "volume": 1.5,
                    "pitch": 1.1
                },
                {
                    "type": "origins:execute_command",
                    "command": "summon armor_stand ^ ^ ^0.3 {Invisible:1b,Marker:1b,PersistenceRequired:1b,Invulnerable:1b,NoGravity:1b,Tags:['weaverLightOrb','tempBeaconMarker']}"
                },
                {
                    "type": "origins:execute_command",
                    "command": "function lightweaver:sid/beacon"
                },
                {
                    "type": "origins:execute_command",
                    "command": "execute at @s as @e[type=armor_stand,limit=1,sort=nearest,tag=weaverLightOrb] if score @p BeaconSID = @s BeaconSID positioned as @p run tp ~ ~1 ~"
                },
                {
                    "type": "origins:execute_command",
                    "command": "execute at @s as @e[type=armor_stand,limit=1,sort=nearest,tag=weaverLightOrb] if score @p BeaconSID = @s BeaconSID run scale set pehkui:width 2.5 @s"
                },
                {
                    "type": "origins:change_resource",
                    "resource": "*:*_active",
                    "operation": "set",
                    "change": 1
                },
                {
                    "type": "origins:change_resource",
                    "resource": "*:*_moving",
                    "operation": "set",
                    "change": 1
                }
            ]
        },
        "condition": {
            "type": "origins:and",
            "conditions": [
                {
                    "type": "origins:resource",
                    "resource": "*:*_active",
                    "comparison": "==",
                    "compare_to": 0
                }
            ]
        },
        "hud_render": {
            "should_render": true,
            "sprite_location": "origins:textures/gui/community/spiderkolo/resource_bar_02.png",
            "bar_index": 8
        },
        "key": {
            "key": "key.origins.primary_active"
        },
        "cooldown": 400
    },
    "move": {
        "type": "origins:action_over_time",
