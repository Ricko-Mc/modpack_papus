		{
			dependencies: ["1E71B57AD2BD8F84"]
			description: [
				"Your first stop in the wastes is a massive labyrinth of brick halls and bridges.  "
				""
				"Scattered stockpiles of gathered treasures and seemingly purposeless rooms abound, and the occasional tower with a focusing cage spewing elemental creatures of flame and rage.  "
				""
				"You have encountered a blackened variant of skeletal menace here, which sucks the life out of any unfortunate enough to make contact with its charred bones."
			]
			id: "7B56B7393B067482"
			rewards: [{
				exclude_from_claim_all: true
				id: "74F1CE60D0F79755"
				table_id: 5393747632124787178L
				type: "loot"
			}]
			subtitle: "But...where do these halls GO?"
