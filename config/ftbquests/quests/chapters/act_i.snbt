	quest_links: [ ]
	quests: [
		{
			description: [
				"You've traveled, you've met many a villager and emeralds in the thousands have changed hands to buy you the materials you need to survive and thrive in this strange world. Your base is fortified, and all the logistics are sorted to keep your people fed and the forges burning."
				""
				"All that really remains is to head out into the untamed places and prove your right to rule them all! So suit up, call your banners, gather your hardiest companions, and prepare for a challenge!"
			]
			icon: {
				Count: 1
				id: "born_in_chaos_v1:skullbreaker_hammer"
				tag: {
					Damage: 0
				}
			}
			id: "03E28F1CA713BA8E"
			rewards: [{
				id: "75A53A199C0D6453"
				type: "xp"
				xp: 100
			}]
			shape: "pentagon"
			size: 1.5d
			subtitle: "You CAN get there from here!"
			tasks: [{
				id: "3DF5AFBA14E834C6"
				title: "Establishing Credibility"
				type: "checkmark"
			}]
			title: "Time for your Adventure!"
			x: -9.0d
			y: -19.0d
		}
		{
			dependencies: ["03E28F1CA713BA8E"]
			description: [
				"Welcome to the Nether—A realm of unrested souls, where unbearable heat clings to every breath, Sulfur hangs heavy in the air, and sorrowful echoes drift through the crimson skies."
				""
				"The feelings of rot and corruption permeating this place remind you of the battles against the Night Lich and the Twilight Lich.  Something here in this blazing hellscape resonates with the undead you felt both in the Overworld and the Twilight realm, something sinister and powerful.  Find it, and perhaps you can glean some insight regarding the Risen Dead and their heavy presence in The Realms."
				""
				"&6Advancement required:&f"
				"Slay the &2Naga&f in the &aTwilight Forest&f to be able to enter &cThe Nether&f!  Standard portal construction rules apply!"
			]
			icon: "minecraft:crying_obsidian"
			id: "1E71B57AD2BD8F84"
			rewards: [{
				exclude_from_claim_all: true
				id: "12FE1BF3C5C6AF7E"
				table_id: 5393747632124787178L
				type: "loot"
			}]
			subtitle: "Most of the floor is actually lava."
			tasks: [{
				dimension: "minecraft:the_nether"
				id: "54EC71016D464C6B"
				type: "dimension"
			}]
			title: "The Nether"
			x: -6.5d
			y: -19.0d
		}
		{
			dependencies: ["03E28F1CA713BA8E"]
			description: [
				"You've heard from some of the more adventurous wandering traders that there is a forest realm draped in twilight and brimming with new regions to explore and, of course, treasure to plunder.  Tales from these wanderers lead you to understand that entry to this gloaming wood requries a ritual sacrifice of a valuable gemstone and mastery of magic sufficient to imbue your panoply with energies that allow you to exceed the limits of even the most fantastical materials you have encountered."
				""
				"&6Advancement required:&f"
				"&dEnchant&f your first piece of equipment or tool to be able to enter &aThe Twilight Forest&f"
			]
			icon: "twilightforest:twilight_portal_miniature_structure"
			id: "762C0381A3EC5E7E"
			require_sequential_tasks: true
			rewards: [{
				exclude_from_claim_all: true
				id: "00D78F2EA967F36B"
				table_id: 3034821864176397678L
				type: "random"
			}]
			subtitle: "The Twilight Realm"
			tasks: [
				{
					advancement: "minecraft:story/enchant_item"
