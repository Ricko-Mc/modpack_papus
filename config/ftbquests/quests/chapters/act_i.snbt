		}
		{
			dependencies: ["03E28F1CA713BA8E"]
			description: ["Carving your way through the endless horde of Undead has proven an excellent source of organic materials and ammunition.  It seems that these creatures also carry a star-shaped object that pulses with cold energy.  Your first instinct was to throw the item away, but tossing it aside showed unexpected properties; it simply rose into the air and started moving away from you as though following some distant call. Perhaps finding more of these stars and following them will yield further unexpected results."]
			hide_until_deps_complete: true
			icon: "bosses_of_mass_destruction:soul_star"
			id: "6D6B92717EF302D5"
