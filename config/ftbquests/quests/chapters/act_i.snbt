		{
			dependencies: ["0A1377FFF7BFA159"]
			description: [
				"Sunken in the seemingly endless oceans of molten rock, you find another massive blackstone structure. This has the feeling of a combat arena, but there do not seem to be any barracks or cages for participants...only an obelisk of more blackstone with four faces carved in relief."
				""
				"&o&7[Hint: Breaking one of these blocks will cause the monument to open, and the Nether Gauntlet will appear.]"
			]
			icon: "born_in_chaos_v1:spawn_structures_lookout_tower"
			id: "3C3428568C29E523"
